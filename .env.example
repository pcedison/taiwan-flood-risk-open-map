# Flood Risk local runtime configuration.
# Copy values into a local .env file and replace change-me values before deployment.
# Zeabur single-service preview:
# - Service type: Dockerfile
# - Root Directory: repository root
# - Build Command / Start Command: leave blank
# - Health Check: /health, not /ready until PostgreSQL and Redis are attached
# - NEXT_PUBLIC_API_BASE_URL should be empty in Zeabur single-service mode;
#   the web client will keep same-origin /v1 calls and Next rewrites proxy them.
# - NEXT_PUBLIC_BASEMAP_* values are client build-time inputs; configure them
#   before building the image or rebuild after changing the public basemap.
# See docs/runbooks/zeabur-single-service-env.md for the non-engineer checklist.

APP_ENV=local
DEPLOYMENT_SHA=
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BASEMAP_STYLE_URL=
NEXT_PUBLIC_BASEMAP_KIND=
NEXT_PUBLIC_BASEMAP_PMTILES_URL=
NEXT_PUBLIC_BASEMAP_RASTER_TILES=
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_BEARER_TOKEN=

# API request-path repositories share one psycopg connection pool per
# database URL (health checks and admin paths intentionally stay unpooled).
# Defaults suit a 2 vCPU node; raise MAX_SIZE with care — each Postgres
# backend costs ~5-10 MB RSS on the shared node.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT_SECONDS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flood_risk
POSTGRES_USER=flood_risk
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://flood_risk:change-me-local@postgres:5432/flood_risk

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local
MINIO_BUCKET_RAW_SNAPSHOTS=flood-risk-raw

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
NODE_EXPORTER_PORT=9100

WORKER_QUEUE=default
WORKER_IDLE_SECONDS=60
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_TICKS=
SCHEDULER_LEASE_TTL_SECONDS=600
WORKER_RUNTIME_FIXTURES_ENABLED=false
WORKER_RUNTIME_JOB_LEASE_SECONDS=300
WORKER_INSTANCE=local
WORKER_METRICS_TEXTFILE_PATH=
SCHEDULER_METRICS_TEXTFILE_PATH=

# Optional comma-separated production allowlist. Empty keeps legacy SOURCE_* flags/defaults.
# Terms-reviewed adapters still require SOURCE_TERMS_REVIEW_ACK=true; sample adapters still
# require SOURCE_SAMPLE_DATA_ENABLED=true.
WORKER_ENABLED_ADAPTER_KEYS=

SOURCE_CWA_ENABLED=false
SOURCE_CWA_HEAVY_RAIN_WARNING_ENABLED=false
SOURCE_NCDR_CAP_ENABLED=false
SOURCE_NPA_POLICE_RADIO_ENABLED=false
SOURCE_WRA_ENABLED=false
SOURCE_WRA_FLOOD_WARNING_ENABLED=false
SOURCE_WRA_HISTORICAL_FLOOD_ENABLED=false
SOURCE_NSTC_FLOOD_DISASTER_POINTS_ENABLED=false
SOURCE_WRA_FLOOD_INCIDENT_ENABLED=false
SOURCE_FLOOD_POTENTIAL_ENABLED=false
# Civil IoT Taiwan (ci.taiwan.gov.tw) SensorThings sources, disabled by default.
SOURCE_FLOOD_SENSOR_ENABLED=false
SOURCE_CIVIL_IOT_RIVER_ENABLED=false
SOURCE_CIVIL_IOT_POND_ENABLED=false
SOURCE_CIVIL_IOT_SEWER_ENABLED=false
SOURCE_CIVIL_IOT_PUMP_ENABLED=false
SOURCE_NEWS_ENABLED=false
SOURCE_FORUM_ENABLED=false
SOURCE_PTT_ENABLED=false
SOURCE_DCARD_ENABLED=false
SOURCE_PTT_CANDIDATE_APPROVAL_ACK=false
SOURCE_DCARD_CANDIDATE_APPROVAL_ACK=false
SOURCE_TERMS_REVIEW_ACK=false
SOURCE_SAMPLE_DATA_ENABLED=false

# Local smoke/E2E can disable DB-backed evidence reads, persistence, and query
# heat while still exercising local fallback records.
EVIDENCE_REPOSITORY_ENABLED=true

# Optional comma-separated CSV/JSONL files for project-controlled open-data
# geocoding. Columns/keys: name,address/road_name/poi_name,aliases,lat,lng,
# admin_code,precision,type,source. TGOS is not required for this path.
GEOCODER_OPEN_DATA_PATHS=
GEOCODER_BUNDLED_OPEN_DATA_ENABLED=true
GEOCODER_POSTGIS_ENABLED=false
GEOCODER_POSTGIS_BOOTSTRAP_ENABLED=false

# Bounded GDELT public-news rehearsal / production-candidate controls.
# Keep all disabled until source/legal review, egress cadence, and alert ownership are accepted.
# Production-candidate runs require both a concrete external evidence path and ACK=true.
GDELT_SOURCE_ENABLED=false
GDELT_BACKFILL_ENABLED=false
GDELT_REHEARSAL_QUERIES=
GDELT_REHEARSAL_MAX_RECORDS_PER_QUERY=10
GDELT_REHEARSAL_CADENCE_SECONDS=60
GDELT_PRODUCTION_INGESTION_ENABLED=false
GDELT_PRODUCTION_APPROVAL_EVIDENCE_PATH=
GDELT_PRODUCTION_APPROVAL_EVIDENCE_ACK=false
GDELT_PRODUCTION_QUERIES=
GDELT_PRODUCTION_MAX_RECORDS_PER_QUERY=10
GDELT_PRODUCTION_CADENCE_SECONDS=60

# Public API on-demand historical news enrichment.
# Local preview defaults may enable this when APP_ENV=local; production must keep explicit
# source/legal ACKs, bounded max records, and a kill switch.
HISTORICAL_NEWS_ON_DEMAND_ENABLED=true
HISTORICAL_NEWS_ON_DEMAND_WRITEBACK_ENABLED=true
HISTORICAL_NEWS_ON_DEMAND_MAX_RECORDS=5
HISTORICAL_NEWS_ON_DEMAND_TIMEOUT_SECONDS=4
# Nationwide citation-only lookup of recent Taiwan government flood pages via
# Google News/Bing RSS. Off by default since 2026-09-04: it runs on the request
# path (4-13 s per assessment) and admitted non-incident pages as evidence.
# When off, previously persisted rows from this source are excluded from scoring.
OFFICIAL_NATIONWIDE_HISTORY_CITATIONS_ENABLED=false
# Deprecated single-city lookup. Existing evidence remains auditable, but the
# active request path is the nationwide source above.
OFFICIAL_TAINAN_HISTORY_NEWS_ENABLED=false
RISK_ASSESSMENT_RESPONSE_CACHE_SECONDS=0
# redis|memory. Hosted runtimes default to redis (shared across replicas, fails
# open to process memory); local/test default to memory.
RISK_ASSESSMENT_RESPONSE_CACHE_BACKEND=memory
# Local/test-only runtime MVT fallback. Hosted environments default to false.
TILE_DYNAMIC_FALLBACK_ENABLED=true

# Runtime public risk API realtime observations.
# Uses official CWA rainfall and WRA water-level open data for nearby station evidence.
# data.gov.tw is the primary public catalog reference:
# - rainfall: https://data.gov.tw/dataset/9177 (CWA O-A0002-001 resource)
# - water level: https://data.gov.tw/dataset/25768 (WRA realtime resource)
# REALTIME_OFFICIAL_ENABLED is the global switch; individual source gates below
# must also be true before live CWA/WRA HTTP calls are made.
REALTIME_OFFICIAL_ENABLED=true
CWA_API_AUTHORIZATION=
OFFICIAL_REALTIME_FETCH_TIMEOUT_SECONDS=3
OFFICIAL_REALTIME_CACHE_STALE_SECONDS=1800

# Worker official ingestion live-client gates. In the Zeabur single-service
# Dockerfile, `auto` starts the scheduler when `DATABASE_URL`/`WORKER_DATABASE_URL`
# is attached. Force mode retires legacy scheduler/source stops; use the
# dedicated emergency stop below for an unconditional current shutdown.
# See docs/data-sources/official/official-source-catalog.yaml for the
# data.gov.tw dataset IDs, resource URLs, licenses, and limitations.
HOSTED_INGESTION_SCHEDULER_ENABLED=auto
REALTIME_BACKBONE_FORCE_INGESTION_ON_START=true
REALTIME_BACKBONE_INGESTION_DISABLED=false
# Unconditional current emergency stop. This overrides force mode; remove it
# after the incident instead of leaving an unbounded legacy stop behind.
REALTIME_BACKBONE_EMERGENCY_STOP=false
REALTIME_BACKBONE_ADAPTER_KEYS=official.cwa.rainfall,official.cwa.tide_level,official.wra.water_level,official.wra_iow.flood_depth,official.ncdr.cap,official.civil_iot.flood_sensor,official.civil_iot.sewer_water_level,official.civil_iot.pump_water_level,official.civil_iot.gate_water_level,local.tainan.flood_sensor,official.wra.historical_flood,official.nstc.flood_disaster_points
RUN_DATABASE_MIGRATIONS_ON_START=true
# Startup migration safety bounds. The runner also serializes replicas with a
# PostgreSQL session advisory lock and commits each migration independently.
MIGRATION_LOCK_TIMEOUT_MS=10000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
WORKER_ENABLED_ADAPTER_KEYS=official.cwa.rainfall,official.cwa.tide_level,official.wra.water_level,official.wra_iow.flood_depth,official.ncdr.cap,official.civil_iot.flood_sensor,official.civil_iot.sewer_water_level,official.civil_iot.pump_water_level,official.civil_iot.gate_water_level,local.tainan.flood_sensor,official.wra.historical_flood,official.nstc.flood_disaster_points
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_LEASE_TTL_SECONDS=600
# Prune realtime official evidence (rainfall, water_level, and flood_warning
# from NCDR CAP) older than this many hours during scheduler maintenance, so
# live ingestion stays bounded on a small node. Only source_type='official'
# rows are pruned. flood_report is intentionally NOT pruned: profile scoring
# counts it as observed flood history (see jobs/evidence_retention.py).
EVIDENCE_REALTIME_RETENTION_HOURS=48
# ADR-0006: location_queries rows only hold coarse (~1 km) buckets, and even
# those are pruned after this many hours (default 30 days, comfortably above
# the P7D live query-heat window). Cascades clean up linked assessments.
LOCATION_QUERIES_RETENTION_HOURS=720
# staging_evidence keeps one audit row per normalized item per ingestion cycle
# and had never been pruned (14.35 M rows / 21.5 GB on the hosted node,
# 2026-09-06, see #367). Scheduler maintenance runs two passes over it, both
# using this retention window:
#
#   1. rejected  -- terminal, never read again (#370).
#   2. accepted  -- only rows of a realtime-cadence adapter that no evidence
#      row references any more (#372). ~10.4 M of the hosted node's 12.6 M
#      accepted rows are that: realtime telemetry that was promoted and whose
#      evidence row EVIDENCE_REALTIME_RETENTION_HOURS then deleted, leaving a
#      staging row nothing can ever read again. Historical (NSTC, WRA
#      historical flood), static and warning-event adapters are excluded, and
#      so is any row an evidence row still points at.
STAGING_EVIDENCE_RETENTION_DAYS=7
# Rows per batch and batches per maintenance cycle. Measured on local PostGIS
# with 500 000 aged rejected rows (117 MB table): a 5 000-row batch costs
# ~100 ms, so a full 10-batch cycle deletes 50 000 rows in ~1 s and stays far
# inside the per-batch statement_timeout below. The hosted table is disk-bound,
# so budget several times that per batch and still comfortably under the limit.
# What paces the backfill is the 300 s scheduler interval, not the batch cost:
# 50 000 rows/cycle = ~14.4 M rows/day, so a ~14 M row backlog clears in about
# a day. Each batch is its own transaction, so a cycle never blocks writes.
STAGING_EVIDENCE_RETENTION_MAX_BATCHES=10
STAGING_EVIDENCE_RETENTION_BATCH_SIZE=5000
# Per-batch statement_timeout. A batch that cannot finish inside it is
# cancelled, the cycle stops with stopped_reason=statement_timeout, and nothing
# is retried until the next cycle.
STAGING_EVIDENCE_RETENTION_STATEMENT_TIMEOUT_MS=5000
# The prune depends on a partial index the job builds itself with CREATE INDEX
# CONCURRENTLY, because a migration cannot build one on a 14 M row table
# without taking the API down (#317). Until that index is valid the job deletes
# nothing (stopped_reason=index_not_ready) rather than fall back to the
# pathological scan. On 14 M rows the concurrent build takes minutes to tens of
# minutes and is IO-heavy; set this to false and create the index by hand in a
# maintenance window instead (the exact SQL is in
# docs/runbooks/worker-scheduler-deployment.md). With it false the deletes
# still run -- only the build step is skipped.
STAGING_EVIDENCE_RETENTION_ENSURE_INDEX=true
# Set to false to stop the staging prune without redeploying (for example
# while a manual VACUUM or pg_repack holds the table).
STAGING_EVIDENCE_RETENTION_ENABLED=true
# The accepted-orphan pass (#372) runs after the rejected pass with its own
# batch budget, so throttling or stopping it never touches the rejected
# backlog. Same batch size, statement_timeout and retention window as above.
STAGING_EVIDENCE_ACCEPTED_RETENTION_ENABLED=true
STAGING_EVIDENCE_ACCEPTED_RETENTION_MAX_BATCHES=10
# Unlike the rejected pass, this one cannot ask for "the oldest 5 000
# eligible rows": the rows it keeps (~2.25 M still referenced by an evidence
# row) stay at the head of the index forever, so an unwindowed batch
# re-probes that whole surviving prefix before reaching a new orphan --
# measured at 405 k probes, 1.6 M buffers and 1.43 s for one batch at a
# 400 k prefix, growing every cycle until every batch times out.
#
# So it sweeps a created_at window at a time behind a watermark, and the
# work per statement is set by how many rows the window holds. One hour of
# hosted ingestion is ~48 k staging rows. A window that still times out is
# halved down to the floor below and doubles back up after each swept
# window.
STAGING_EVIDENCE_ACCEPTED_RETENTION_WINDOW_SECONDS=3600
STAGING_EVIDENCE_ACCEPTED_RETENTION_MIN_WINDOW_SECONDS=300
# The watermark lives in memory only, so restarting the worker re-sweeps
# from the oldest accepted row. A window that deletes *nothing* may double
# past the ceiling above, up to this one, which is what makes that re-sweep
# cheap: at a fixed 1 h ceiling, re-crossing 16 days of cleared history
# takes ~38 cycles (~3.2 h); doubling through it takes about 4. Any window
# that finds rows drops straight back to the normal ceiling.
STAGING_EVIDENCE_ACCEPTED_RETENTION_MAX_WINDOW_SECONDS=86400
# The evidence table is high churn -- realtime rows arrive every cycle and are
# deleted 48 h later, and each historical snapshot re-imports a whole batch --
# and no VACUUM ever returns an index page. On 2026-09-07 the hosted evidence
# table was 2.27 M rows / 5.4 GB of heap under 2.26 GB of indexes, and a 500 m
# nearby-evidence probe read 2 875 cold blocks to fetch 168 candidate rows
# whose data adds up to 0.1 MiB: almost all of those blocks were index pages.
# Scheduler maintenance rebuilds one of those indexes at a time with
# REINDEX INDEX CONCURRENTLY, which takes no write lock (#317).
# Set to false to stop rebuilding without redeploying.
EVIDENCE_INDEX_REINDEX_ENABLED=true
# UTC maintenance window, HH:MM-HH:MM. The default is 02:00-05:00 Taipei, the
# daily traffic trough. A window may cross midnight (e.g. 22:00-02:00).
# Outside it the pass does nothing at all.
EVIDENCE_INDEX_REINDEX_WINDOW_UTC=18:00-21:00
# Comma-separated override for which indexes are eligible, in priority order.
# Names must be plain [a-z0-9_] identifiers. Leave empty to use the built-in
# list in apps/workers/app/jobs/index_maintenance.py, which starts with the
# partial GiST index the assessment read path scans.
EVIDENCE_INDEX_REINDEX_INDEXES=
# At most one index is rebuilt per maintenance cycle, and each index at most
# once per this many hours (default one week). The schedule lives in memory, so
# a worker restart makes the next window rebuild one more round.
EVIDENCE_INDEX_REINDEX_INTERVAL_HOURS=168
# Indexes smaller than this are skipped: rebuilding them costs about as much as
# leaving them bloated. Every hosted evidence index worth rebuilding is 7.5 MiB
# or larger.
EVIDENCE_INDEX_REINDEX_MIN_SIZE_BYTES=8388608
# ...and indexes larger than this are skipped too (skipped_too_large), because
# the old and the new index coexist for the whole of a concurrent rebuild: the
# operation needs the index's own size again in free disk. The hosted database
# is ~30 GB on a Zeabur volume whose free space the worker cannot read, and
# filling it locks the table and returns 502s (#317). At the default 512 MiB
# the 933 MiB evidence_source_raw_ref_unique waits until an operator has
# checked the volume; raise it deliberately then. Skipping does not consume the
# cycle's single rebuild -- the next index on the list still gets its turn.
EVIDENCE_INDEX_REINDEX_MAX_INDEX_BYTES=536870912
# The brief locks a concurrent rebuild does take must never queue behind
# ingestion, and a rebuild must not run past the window into morning traffic.
# On a refused lock or a cancelled statement the pass logs the SQLSTATE and
# does not try that index again until the next window.
EVIDENCE_INDEX_REINDEX_LOCK_TIMEOUT_MS=5000
EVIDENCE_INDEX_REINDEX_STATEMENT_TIMEOUT_MS=1800000
WORKER_DATABASE_URL=
SOURCE_CWA_API_ENABLED=false
CWA_API_URL=
CWA_API_TIMEOUT_SECONDS=8
SOURCE_CWA_HEAVY_RAIN_WARNING_API_ENABLED=false
SOURCE_CWA_HEAVY_RAIN_WARNING_CONTRACT_ENABLED=false
CWA_HEAVY_RAIN_WARNING_CAP_URL=
CWA_HEAVY_RAIN_WARNING_TIMEOUT_SECONDS=8
SOURCE_WRA_API_ENABLED=false
WRA_API_URL=
WRA_STATION_API_URL=
WRA_API_TOKEN=
