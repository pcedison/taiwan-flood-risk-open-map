{
  "name": "flood-risk-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "e2e": "npm run clean:next && playwright test",
    "e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\""
  },
  "dependencies": {
    "maplibre-gl": "^5.0.0",
    "next": "^16.2.12",
    "pmtiles": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "5.4.0",
    "minimatch@3": "10.2.6",
    "postcss": "^8.5.26",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3"
  }
}
